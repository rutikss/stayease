{
  "name": "stayease",
  "version": "1.0.0",
  "description": "Full-stack property listing and booking platform (Node.js / Express / MongoDB / EJS)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --runInBand --forceExit",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "keywords": ["nodejs", "expressjs", "mongodb", "ejs", "cloudinary", "passport", "booking-platform", "airbnb-clone"],
  "author": "Rutik Shelke",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "cloudinary": "^2.9.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "ejs-mate": "^4.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "joi": "^18.0.2",
    "lusca": "^1.7.0",
    "method-override": "^3.0.0",
    "mongoose": "^9.2.1",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
