<% layout("layouts/boilerplate.ejs") %>

<div class="mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0 fs-4">My Bookings</h1>
        <a href="/Listings" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-magnifying-glass me-1"></i>Browse Listings
        </a>
    </div>

    <% if (bookings.length === 0) { %>
        <div class="empty-state text-center py-5">
            <i class="fa-solid fa-calendar-xmark fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No bookings yet</h5>
            <p class="text-secondary">Find a place and make your first reservation.</p>
            <a href="/Listings" class="btn btn-primary mt-2">Explore Listings</a>
        </div>
    <% } else { %>
        <div class="row g-4">
            <% for (let booking of bookings) { %>
                <% if (!booking.listing) continue; %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border rounded-4 overflow-hidden h-100 shadow-sm">
                        <img
                            src="<%= booking.listing.image.url %>"
                            class="card-img-top"
                            style="height: 180px; object-fit: cover;"
                            alt="<%= booking.listing.title %>"
                            loading="lazy"
                        >
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">
                                <a href="/Listings/<%= booking.listing._id %>" class="text-dark text-decoration-none listing-title-link">
                                    <%= booking.listing.title %>
                                </a>
                            </h6>

                            <div class="d-flex flex-column gap-1 mb-3">
                                <div class="detail-row">
                                    <i class="fa-regular fa-calendar-check detail-icon"></i>
                                    <span>
                                        <strong>Check-in:</strong>
                                        <%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %>
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <i class="fa-regular fa-calendar-xmark detail-icon"></i>
                                    <span>
                                        <strong>Check-out:</strong>
                                        <%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %>
                                    </span>
                                </div>
                                <div class="detail-row">
                                    <i class="fa-solid fa-users detail-icon"></i>
                                    <span><%= booking.guests %> guest<%= booking.guests > 1 ? "s" : "" %></span>
                                </div>
                                <div class="detail-row">
                                    <i class="fa-solid fa-indian-rupee-sign detail-icon"></i>
                                    <span><strong>₹<%= booking.totalPrice.toLocaleString("en-IN") %></strong> total</span>
                                </div>
                            </div>

                            <span class="badge booking-status-badge booking-status-<%= booking.status %>">
                                <i class="fa-solid fa-circle me-1" style="font-size:0.5rem; vertical-align: middle;"></i>
                                <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                            </span>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3 d-flex gap-2">
                            <a href="/Listings/<%= booking.listing._id %>" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                View Listing
                            </a>
                            <% if (booking.status !== "cancelled") { %>
                                <form action="/bookings/<%= booking._id %>/cancel?_method=PATCH" method="post" class="flex-grow-1">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                        onclick="return confirm('Cancel this booking?')">
                                        Cancel
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>

</div>
