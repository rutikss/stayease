<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#0F766E">

        <%
          const _title = (typeof pageTitle !== 'undefined' && pageTitle)
            ? pageTitle + ' — StayEase'
            : 'StayEase — Find your perfect stay';
          const _desc  = (typeof pageTitle !== 'undefined' && pageTitle)
            ? pageTitle + ' on StayEase — discover and book unique stays around the world.'
            : 'StayEase — discover and book unique holiday homes, cabins, beach houses and luxury stays worldwide.';
          const _img   = (typeof ogImage !== 'undefined' && ogImage)
            ? ogImage
            : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200&q=80';
          const _url   = 'https://stayease.example.com' + (typeof currentPath !== 'undefined' ? currentPath : '/');
        %>

        <title><%= _title %></title>
        <meta name="description" content="<%= _desc %>">
        <link rel="canonical" href="<%= _url %>">

        <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
        <meta property="og:type"        content="website">
        <meta property="og:site_name"   content="StayEase">
        <meta property="og:title"       content="<%= _title %>">
        <meta property="og:description" content="<%= _desc %>">
        <meta property="og:image"       content="<%= _img %>">
        <meta property="og:url"         content="<%= _url %>">

        <!-- Twitter Card -->
        <meta name="twitter:card"        content="summary_large_image">
        <meta name="twitter:title"       content="<%= _title %>">
        <meta name="twitter:description" content="<%= _desc %>">
        <meta name="twitter:image"       content="<%= _img %>">

        <link rel="icon" type="image/svg+xml" href="/favicon.svg">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
        crossorigin="anonymous">
        <link rel="stylesheet" 
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" 
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" 
        crossorigin="anonymous" 
        referrerpolicy="no-referrer" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/css/style.css">
        <link rel="stylesheet" href="/css/rating.css">
    </head>

    <body>
        <%- include("../includes/navbar.ejs") %> 
        <div class="container">
            <%- include("../includes/flash.ejs") %>
            <%- body %>
        </div>
        <%- include("../includes/footer.ejs") %>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/JS/script.js"></script>
    </body>
</html>