<% layout("layouts/boilerplate.ejs") %>

<div class="mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-11">

            <!-- Image Gallery -->
            <div class="card rounded-4 m-2 bg-light overflow-hidden mb-4">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <div class="gallery-main">
                            <img src="<%= listing.image.url %>" class="w-100" alt="<%= listing.title %>" loading="eager">
                        </div>
                    </div>
                    <div class="col-md-6 d-none d-md-block">
                        <div class="row g-2">
                            <div class="col-6"><div class="gallery-side"><img src="<%= listing.image.url %>" alt="" loading="lazy"></div></div>
                            <div class="col-6"><div class="gallery-side right_top"><img src="<%= listing.image.url %>" alt="" loading="lazy"></div></div>
                            <div class="col-6"><div class="gallery-side"><img src="<%= listing.image.url %>" alt="" loading="lazy"></div></div>
                            <div class="col-6"><div class="gallery-side right_bottom"><img src="<%= listing.image.url %>" alt="" loading="lazy"></div></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content + Booking Sidebar -->
            <div class="row g-4 px-2">

                <!-- LEFT: Details + Reviews -->
                <div class="col-lg-7">

                    <!-- Back link + title -->
                    <a href="/Listings" class="back-link text-muted text-decoration-none d-inline-flex align-items-center gap-1 mb-3">
                        <i class="fa-solid fa-arrow-left" style="font-size:0.85rem;"></i>
                        <span style="font-size:0.9rem;">All listings</span>
                    </a>
                    <h1 class="listing-title fw-bold mb-4"><%= listing.title %></h1>

                    <div class="listing-details d-flex flex-column gap-2 mb-4">
                        <div class="detail-row">
                            <i class="fa-solid fa-user detail-icon"></i>
                            <span>Hosted by <strong><%= listing.owner.username %></strong></span>
                        </div>
                        <div class="detail-row">
                            <i class="fa-solid fa-indian-rupee-sign detail-icon"></i>
                            <span><strong><%= listing.price.toLocaleString("en-IN") %></strong> per night</span>
                        </div>
                        <div class="detail-row">
                            <i class="fa-solid fa-align-left detail-icon"></i>
                            <div class="desc-wrapper">
                                <p class="desc-text mb-0"><%= listing.description %></p>
                                <button class="btn btn-link btn-sm p-0 mt-1 desc-toggle text-primary d-none" type="button">Show more</button>
                            </div>
                        </div>
                        <div class="detail-row">
                            <i class="fa-solid fa-location-dot detail-icon"></i>
                            <span><%= listing.location %>, <%= listing.country %></span>
                        </div>
                        <div class="detail-row">
                            <i class="fa-regular fa-calendar detail-icon"></i>
                            <span>Listed on <%= new Date(listing.createdAt).toLocaleDateString("en-IN", { year:"numeric", month:"long", day:"numeric" }) %></span>
                        </div>
                    </div>

                    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                        <div class="d-flex gap-3 mb-4">
                            <a href="/Listings/<%= listing.id %>/edit" class="btn btn-outline-primary px-4">
                                <i class="fa-solid fa-pen me-1"></i>Edit
                            </a>
                            <form action="/Listings/<%= listing.id %>?_method=DELETE" method="post">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button class="btn btn-outline-danger px-4"
                                        onclick="return confirm('Delete this listing? This cannot be undone.')">
                                    <i class="fa-solid fa-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    <% } %>

                    <hr class="my-4">

                    <!-- Review Form -->
                    <% if(currUser) { %>
                        <% if(!currUser._id.equals(listing.owner._id)) { %>
                        <div class="review-form mb-4">
                            <h5 class="fw-bold mb-3">Leave a Review</h5>
                            <form action="/Listings/<%= listing.id %>/reviews" class="needs-validation" method="post" novalidate>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <fieldset class="starability-grow mb-3">
                                    <legend class="visually-hidden">Rate this listing</legend>
                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="review[rating]" value="1" /><label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="review[rating]" value="2" /><label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" /><label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="review[rating]" value="4" /><label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="review[rating]" value="5" /><label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                                <label for="comm" class="form-label fw-semibold text-muted">Comment</label>
                                <textarea name="review[comment]" id="comm" class="form-control mb-2" rows="3" required></textarea>
                                <div class="invalid-feedback">Please add a comment.</div>
                                <button class="btn btn-primary px-4 mt-1">Submit Review</button>
                            </form>
                        </div>
                        <% } else { %>
                            <p class="text-muted fst-italic mb-4">Hosts cannot review their own listing.</p>
                        <% } %>
                        <hr class="my-4">
                    <% } %>

                    <!-- All Reviews -->
                    <% if(listing.reviews && listing.reviews.length > 0) { %>
                        <div class="all_reviews">
                            <h2 class="fs-5 fw-bold mb-3">Reviews (<%= listing.reviews.length %>)</h2>
                            <div class="row g-3">
                                <% for (let review of listing.reviews) { %>
                                    <div class="col-12 col-md-6">
                                        <div class="card p-3 gap-2 rounded-4 review border">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="fw-semibold">@<%= review.author.username %></div>
                                                <% if(review.createdAt) { %>
                                                    <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString("en-IN", { month:"short", day:"numeric", year:"numeric" }) %></small>
                                                <% } %>
                                            </div>
                                            <p class="starability-result mb-0" data-rating="<%= review.rating %>"></p>
                                            <div class="card-text"><%= review.comment %></div>
                                            <% if(currUser && currUser._id.equals(review.author._id)) { %>
                                                <form action="/Listings/<%= listing.id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Delete this review? This cannot be undone.')">Delete</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">No reviews yet.<% if(currUser && !currUser._id.equals(listing.owner._id)) { %> Be the first!<% } %></p>
                        </div>
                    <% } %>

                </div>

                <!-- RIGHT: Booking Card -->
                <div class="col-lg-5">
                    <div class="booking-card card border rounded-4 p-4 shadow-sm sticky-top">
                        <div class="d-flex align-items-baseline gap-1 mb-3">
                            <h2 class="fs-5 fw-bold mb-0" data-price="<%= listing.price %>">₹<%= listing.price.toLocaleString("en-IN") %></h2>
                            <span class="text-muted">/ night</span>
                        </div>

                        <% if(currUser) { %>
                            <form action="/Listings/<%= listing.id %>/bookings" method="post" id="booking-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                <div class="booking-date-grid border rounded-3 overflow-hidden mb-1">
                                    <div class="row g-0">
                                        <div class="col-6 border-end p-2">
                                            <label class="booking-label">CHECK-IN</label>
                                            <input
                                                type="date"
                                                name="booking[checkIn]"
                                                id="checkIn"
                                                class="form-control border-0 p-0 pt-1 booking-date-input"
                                                min="<%= new Date().toISOString().split('T')[0] %>"
                                            >
                                        </div>
                                        <div class="col-6 p-2">
                                            <label class="booking-label">CHECK-OUT</label>
                                            <input
                                                type="date"
                                                name="booking[checkOut]"
                                                id="checkOut"
                                                class="form-control border-0 p-0 pt-1 booking-date-input"
                                                min="<%= new Date().toISOString().split('T')[0] %>"
                                            >
                                        </div>
                                    </div>
                                    <div class="border-top p-2">
                                        <label class="booking-label">GUESTS</label>
                                        <input
                                            type="number"
                                            name="booking[guests]"
                                            id="bookingGuests"
                                            class="form-control border-0 p-0 pt-1 booking-date-input"
                                            min="1"
                                            max="16"
                                            value="1"
                                        >
                                    </div>
                                </div>

                                <!-- Inline validation message -->
                                <p id="booking-error" class="text-danger small mb-2 d-none"></p>

                                <!-- Live total estimate -->
                                <div class="booking-total-row d-none mb-2">
                                    <small id="booking-total" class="text-muted"></small>
                                </div>

                                <button id="reserve-btn" class="btn btn-primary w-100 py-2 fw-semibold" type="submit">Reserve</button>
                                <p class="text-center text-muted small mt-2 mb-0">You won't be charged yet</p>
                            </form>
                        <% } else { %>
                            <a href="/logIn" class="btn btn-primary w-100 py-2 fw-semibold">Log in to Book</a>
                            <p class="text-center text-muted small mt-2 mb-0">Create an account to make reservations</p>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
